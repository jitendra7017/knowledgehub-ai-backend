  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "openapi:lint": "redocly lint docs/openapi/v1/openapi.yaml",
    "openapi:bundle": "redocly bundle docs/openapi/v1/openapi.yaml -o docs/openapi/v1/openapi.bundle.yaml",
    "openapi:json": "redocly bundle docs/openapi/v1/openapi.yaml --ext json -o docs/openapi/v1/openapi.bundle.json"
  },
  "dependencies": {
    "@langchain/core": "^1.2.1",
    "@langchain/openai": "^1.5.3",
    "@pinecone-database/pinecone": "^8.0.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.58.5",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^1.5.2",
    "mime-types": "^3.0.1",
    "multer": "^2.0.2",
    "openai": "^6.45.0",
    "pdf-parse": "^1.1.4",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "pino": "^9.9.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.1",
    "redis": "^5.8.2",
    "redoc-express": "^2.1.3",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@redocly/cli": "^1.34.17",
    "eslint": "^9.35.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
