{
  "name": "knowledgehub-ai-backend",
  "version": "1.0.0",
  "description": "",
  "homepage": "https://github.com/jitendra7017/knowledgehub-ai-backend#readme",
  "bugs": {
    "url": "https://github.com/jitendra7017/knowledgehub-ai-backend/issues"
